
#include <bits/stdc++.h>
using namespace std;

using ll = long long;
const ll INF = LLONG_MAX/4;

vector<ll> dijkstra(int s,
    vector<vector<pair<int,int>>> &g) {

    int n = g.size();

    vector<ll> dist(n, INF);

    priority_queue<
        pair<ll,int>,
        vector<pair<ll,int>>,
        greater<pair<ll,int>>
    > pq;

    dist[s] = 0;
    pq.push({0, s});

    while(!pq.empty()) {
        auto [d, u] = pq.top();
        pq.pop();

        if(d != dist[u])
            continue;

        for(auto [v, w] : g[u]) {
            if(dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                pq.push({dist[v], v});
            }
        }
    }

    return dist;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;
    int r; cin >> r;

    vector<vector<pair<int,int>>> g(n);

    for(int i = 0; i < m; i++) {
        int u, v, w;
        cin >> u >> v >> w;
        u; v;

        g[u].push_back({v, w});
        //g[v].push_back({u, w});
    }

    vector<ll> dist = dijkstra(r, g);

    for(int i = 0; i < n; i++) {
        if(dist[i] == INF)
            cout << "INF ";
        else
            cout << dist[i] << "\n";
    }

    cout << "\n";

    return 0;
}
